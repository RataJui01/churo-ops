# Copy to config.env (gitignored) and fill in. Never commit the real file.
NODE_ENV=development
PORT=3000

# Atlas → Connect → Drivers. Keep <db_password> as it is — server.js swaps in
# DATABASE_PASSWORD — and put the database name after the host.
DATABASE=mongodb+srv://<db_user>:<db_password>@<cluster-host>/churo-ops?retryWrites=true&w=majority
DATABASE_PASSWORD=

# node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=30d

# The frontend's address; comma-separate to allow more than one
CLIENT_ORIGIN=http://localhost:5173
