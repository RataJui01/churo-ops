# Copy to config.env (gitignored) and fill in. Never commit the real file.
NODE_ENV=development
PORT=3000

# Atlas → Connect → Drivers. Keep <db_password> as it is — server.js swaps in
# DATABASE_PASSWORD — and put the database name after the host.
DATABASE=mongodb+srv://<db_user>:<db_password>@<cluster-host>/churo-ops?retryWrites=true&w=majority
DATABASE_PASSWORD=

# node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=30d

# The frontend's address; comma-separate to allow more than one
CLIENT_ORIGIN=http://localhost:5173

# Optional, local only: if `npm run dev` fails with "querySrv ECONNREFUSED",
# make Node use these DNS servers (see utils/dnsServers.js)
# DNS_SERVERS=8.8.8.8,1.1.1.1

# Customer storefront: who the payment QR pays. Either the shop's K SHOP QR —
# the text inside its printed QR (decode it once; starts 000201…), which each
# order gets a copy of with its amount filled in — or, if that's not set, a
# PromptPay mobile number (10 digits) or national / tax ID (13 digits).
# Without either the payment page shows no QR (the server still starts).
# PROMPTPAY_MERCHANT_QR=000201010211...
# PROMPTPAY_ID=0812345678
# The account name as bank apps show it, printed under the QR
# PROMPTPAY_NAME=
